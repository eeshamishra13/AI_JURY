# AI Jury (Document Mode) — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on (default: 8000)
PORT=8000

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------

# Your Anthropic API key — required for live LLM answer generation and jurors.
# Leave blank if using MOCK_ANTHROPIC=true for testing / offline demos.
ANTHROPIC_API_KEY=

# Set explicitly to "true" to run in deterministic offline test/demo mode.
# MOCK MODE POLICY:
# - Mock mode requires explicit MOCK_ANTHROPIC=true (never activated implicitly).
# - Mock evaluations are intended for offline tests/demos and are NOT equivalent to live Claude evaluations.
# - The API response includes "evaluationMode": "MOCK" (or "LIVE" when disabled).
# - When MOCK_ANTHROPIC is false/unset, missing ANTHROPIC_API_KEY immediately fails
#   with a sanitized CONFIGURATION_ERROR (HTTP 500) and NEVER silently falls back to mock.
MOCK_ANTHROPIC=false

# ---------------------------------------------------------------------------
# Model selection (optional — defaults shown)
# ---------------------------------------------------------------------------

# Claude model used to generate the grounded answer from document evidence
ANSWER_MODEL=claude-3-5-sonnet-20241022

# Claude model used for LLM jurors (Skeptic, Domain Expert, Context Judge)
JUROR_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Timeouts and retries (optional — defaults shown)
# ---------------------------------------------------------------------------

# Timeout per LLM API call in milliseconds
# Applied to both answer generation and juror calls.
REQUEST_TIMEOUT_MS=15000

# Maximum retries on transient API errors (429, 500, 502, 503, 504)
# Uses exponential backoff with jitter between attempts.
MAX_RETRIES=2

# ---------------------------------------------------------------------------
# File upload limits (optional — defaults shown)
# ---------------------------------------------------------------------------

# Maximum document upload size in megabytes
MAX_FILE_SIZE_MB=20

# ---------------------------------------------------------------------------
# Document storage (optional — defaults shown)
# ---------------------------------------------------------------------------

# Maximum number of documents kept in memory simultaneously (LRU eviction)
MAX_DOCUMENTS=50

# Time-to-live for each document in milliseconds (default: 1 hour)
# TTL is refreshed on each access (sliding window).
DOCUMENT_TTL_MS=3600000

# How often to scan for and evict expired documents (milliseconds)
DOCUMENT_CLEANUP_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Rate limiting (optional — defaults shown)
# ---------------------------------------------------------------------------

# Sliding window duration for rate limiting (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Maximum POST /ask requests per IP per window
ASK_RATE_LIMIT=10

# Maximum POST /documents requests per IP per window
DOCUMENT_RATE_LIMIT=10

# ---------------------------------------------------------------------------
# CORS (optional — leave blank to allow all origins in development)
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins. Leave blank to allow any origin.
# Example: http://localhost:3000,https://myfrontend.example.com
ALLOWED_ORIGINS=
